{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "encounter_table.schema.json",
  "title": "Encounter Table",
  "description": "Schema for a random encounter table in a D&D campaign",
  "type": "object",
  "required": [
    "id",
    "name",
    "die",
    "table"
  ],
  "additionalProperties": false,
  "definitions": {
    "short_text": {
      "type": "string",
      "maxLength": 100
    },
    "long_text": {
      "type": "string",
      "maxLength": 500
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1
    },
    "name": {
      "$ref": "#/definitions/short_text",
      "minLength": 1
    },
    "description": {
      "$ref": "#/definitions/long_text"
    },
    "region_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]*$"
    },
    "terrain": {
      "$ref": "#/definitions/short_text"
    },
    "frequency": {
      "$ref": "#/definitions/short_text"
    },
    "die": {
      "$ref": "#/definitions/short_text",
      "minLength": 1
    },
    "table": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "roll",
          "encounter"
        ],
        "additionalProperties": false,
        "properties": {
          "roll": {
            "type": "integer",
            "minimum": 1
          },
          "encounter": {
            "$ref": "#/definitions/long_text",
            "minLength": 1
          },
          "notes": {
            "$ref": "#/definitions/long_text"
          },
          "roll_to": {
            "type": "integer",
            "minimum": 1,
            "$comment": "Upper end of a roll range; omit for a single number."
          },
          "subtable": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "$comment": "Id of a sub-table to roll on: one in this file's subtables, or another encounter-table file's id."
          }
        }
      }
    },
    "subtables": {
      "type": "array",
      "$comment": "Stretch-specific sub-tables, rolled from a category row.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "die",
          "table"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "die": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "table": {
            "$ref": "#/properties/table"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "in_development",
        "ready",
        "retired"
      ]
    },
    "shared": {
      "type": "boolean",
      "$comment": "True for sub-tables used by several road tables."
    }
  }
}
