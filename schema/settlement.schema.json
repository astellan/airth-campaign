{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "settlement.schema.json",
  "title": "Settlement",
  "description": "Schema for a settlement in a D&D campaign",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "type"
  ],
  "additionalProperties": true,
  "definitions": {
    "short_text": {
      "type": "string",
      "maxLength": 100
    },
    "long_text": {
      "type": "string",
      "maxLength": 500
    },
    "descriptors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "Palette descriptors; a single entry may be an italic detail phrase."
    },
    "time_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dawn": {
          "$ref": "#/definitions/descriptors"
        },
        "day": {
          "$ref": "#/definitions/descriptors"
        },
        "dusk": {
          "$ref": "#/definitions/descriptors"
        },
        "night": {
          "$ref": "#/definitions/descriptors"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 1
    },
    "name": {
      "$ref": "#/definitions/short_text",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "in_development",
        "ready",
        "retired"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "city",
        "town",
        "small_town",
        "village",
        "steading"
      ]
    },
    "parent": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "$comment": "Steadings only: id of the parent settlement."
    },
    "kind": {
      "type": "string",
      "enum": [
        "hamlet",
        "family",
        "seasonal",
        "resource",
        "noxious_trade"
      ],
      "$comment": "Steadings only."
    },
    "why_here": {
      "$ref": "#/definitions/short_text",
      "$comment": "Steadings only: the single reason it exists."
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Arrival palette; see style/settlement.md.",
      "properties": {
        "constants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "far": {
              "$ref": "#/definitions/descriptors"
            },
            "near": {
              "$ref": "#/definitions/descriptors"
            },
            "threshold": {
              "$ref": "#/definitions/descriptors"
            },
            "within": {
              "$ref": "#/definitions/descriptors"
            },
            "leaving": {
              "$ref": "#/definitions/descriptors"
            }
          }
        },
        "by_time": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "far": {
              "$ref": "#/definitions/time_row"
            },
            "near": {
              "$ref": "#/definitions/time_row"
            },
            "threshold": {
              "$ref": "#/definitions/time_row"
            },
            "within": {
              "$ref": "#/definitions/time_row"
            },
            "leaving": {
              "$ref": "#/definitions/time_row"
            }
          }
        },
        "seasons": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "winter": {
              "$ref": "#/definitions/descriptors"
            },
            "spring": {
              "$ref": "#/definitions/descriptors"
            },
            "summer": {
              "$ref": "#/definitions/descriptors"
            },
            "autumn": {
              "$ref": "#/definitions/descriptors"
            }
          }
        },
        "situations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "descriptors"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "when": {
                "type": "string"
              },
              "descriptors": {
                "$ref": "#/definitions/descriptors"
              }
            }
          }
        }
      }
    },
    "neighbors": {
      "type": "array",
      "$comment": "Pointcrawl links; see style/settlement.md.",
      "items": {
        "type": "object",
        "required": [
          "settlement",
          "miles",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "settlement": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "miles": {
            "type": "number",
            "minimum": 0
          },
          "direction": {
            "type": "string",
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tagline": {
      "$ref": "#/definitions/short_text"
    },
    "region": {
      "type": "string"
    },
    "population": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "mix": {
          "type": "string"
        }
      }
    },
    "ruler": {
      "type": "string"
    },
    "faiths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "strangers": {
      "type": "string"
    },
    "equipment": {
      "type": "string"
    },
    "itself": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "encounters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "night": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "watch": {
          "type": [
            "string",
            "null"
          ]
        },
        "arrival_day": {
          "type": [
            "string",
            "null"
          ]
        },
        "arrival_night": {
          "type": [
            "string",
            "null"
          ]
        },
        "reinforcements": {
          "type": [
            "string",
            "null"
          ]
        },
        "bribery": {
          "type": [
            "string",
            "null"
          ]
        },
        "strength_now": {
          "type": [
            "string",
            "null"
          ]
        },
        "strength_founding": {
          "type": [
            "string",
            "null"
          ]
        },
        "strength": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "$comment": "strength: a line of colour on how far the guard has slipped."
    },
    "trouble": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "look"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "$comment": "Key in airth/config/settlement.json location_types."
          },
          "look": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "hidden": {
            "type": "string"
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "membership": {
            "type": "string"
          },
          "scheme": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "steading"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "parent",
          "kind",
          "why_here"
        ]
      }
    }
  ],
  "$comment": "Render order and rules: style/settlement.md. Legacy fields (economy, defenses, location, physical) remain allowed until migration."
}
