{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "settlement.schema.json",
  "title": "Settlement",
  "description": "Schema for a settlement in a D&D campaign",
  "type": "object",
  "required": ["id", "name", "status"],
  "additionalProperties": true,

  "definitions": {
    "short_text": { "type": "string", "maxLength": 100 },
    "long_text":  { "type": "string", "maxLength": 500 }
  },

  "properties": {
    "id":     { "type": "string", "pattern": "^[a-z0-9-]+$", "minLength": 1 },
    "name":   { "$ref": "#/definitions/short_text", "minLength": 1 },
    "status": { "type": "string", "enum": ["stub", "in_development", "ready", "retired"] }
  }
}
