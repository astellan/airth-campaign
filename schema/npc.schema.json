{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC Collection",
  "type": "object",
  "required": [
    "npcs"
  ],
  "properties": {
    "npcs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/npc"
      }
    }
  },
  "definitions": {
    "npc": {
      "type": "object",
      "required": [
        "name",
        "role",
        "home",
        "home_settlement",
        "gender",
        "faction",
        "thinks_with",
        "appearance",
        "wants",
        "does_not_want"
      ],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string"
        },
        "moniker": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "home": {
          "type": "string"
        },
        "home_settlement": {
          "type": "string",
          "$comment": "Reference: must match a key in airth_settlements.json. Use 'itinerant' for NPCs with no fixed settlement."
        },
        "found": {
          "type": [
            "string",
            "null"
          ]
        },
        "gender": {
          "type": "string"
        },
        "faction": {
          "type": "string"
        },
        "thinks_with": {
          "type": "string",
          "enum": [
            "blade",
            "devotion",
            "diplomacy",
            "endurance",
            "faith",
            "fear",
            "fists",
            "guilt",
            "honor",
            "lore",
            "magic",
            "money",
            "persuasion",
            "pride",
            "tradition"
          ]
        },
        "appearance": {
          "type": "string"
        },
        "and_yet": {
          "type": [
            "string",
            "null"
          ]
        },
        "sayings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "wants": {
          "type": "string"
        },
        "does_not_want": {
          "type": [
            "string",
            "null"
          ]
        },
        "dreams": {
          "type": [
            "string",
            "null"
          ]
        },
        "oddly_also": {
          "type": [
            "string",
            "null"
          ]
        },
        "knows": {
          "type": [
            "string",
            "null"
          ]
        },
        "offers": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "anecdotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tragedies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "Field definitions and length rules: style/npc.md. Tests enforce a reduced required set until legacy NPCs are migrated (see backlog)."
    }
  },
  "description": "Schema for a single NPC in a D&D campaign"
}
